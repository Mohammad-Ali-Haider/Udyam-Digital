{
  "name": "udyam-digital",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,expo \"npm run dev -w @udyam/server\" \"npm run start -w @udyam/client\"",
    "dev:server": "npm run dev -w @udyam/server",
    "dev:web": "npm run web -w @udyam/client",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test -w @udyam/server",
    "build": "npm run build -w @udyam/server && npm run build:web -w @udyam/client",
    "start": "npm run start -w @udyam/server",
    "seed": "npm run seed -w @udyam/server",
    "ocr:prepare": "node scripts/prepare-ocr.mjs",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test:web": "node scripts/verify-web.mjs",
    "test:advisor": "node scripts/verify-advisor.mjs",
    "test:live-ai": "tsx scripts/verify-live-ai.mts",
    "staff:setup": "tsx scripts/configure-staff.mts",
    "demo:fixtures": "tsx scripts/seed-service-demo.mts",
    "test:server": "tsx scripts/serve-verification.mts",
    "lint": "npm run lint -w @udyam/client"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
